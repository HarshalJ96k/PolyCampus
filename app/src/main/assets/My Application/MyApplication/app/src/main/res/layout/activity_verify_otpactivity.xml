<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerifyOTPActivity"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/white"
    >
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/otpverify"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OTP Verification"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="24sp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/cambo"
        android:textAlignment="center"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the OTP to"
        android:textColor="@color/black"
        android:textStyle="normal"
        android:textSize="16dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/cambo"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvVerifyOTPMobile"
        android:text="+91-9623126395"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="16dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/cambo"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="20sp"
    android:gravity="center">
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput1"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"/>
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput2"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:layout_marginLeft="4dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"/>
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput3"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:layout_marginLeft="4dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"/>
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput4"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:layout_marginLeft="4dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"/>
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput5"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:layout_marginLeft="4dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"/>
    <EditText
        android:layout_width="40dp"
        android:layout_height="45dp"
        android:id="@+id/etVerifyInput6"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:layout_marginLeft="4dp"
        android:textStyle="normal"
        android:inputType="number"
        android:maxLength="1"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"/>

        
</LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/cambo"
            android:text="Didn't receive the OTP?"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVerifyOTPResentOTP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:fontFamily="@font/cambo"
            android:text="Resent OTP"
            android:textAlignment="center"
            android:textColor="#E53935"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/acbtnVerifyOTPVerify"
        android:text="Verify"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_margin="20dp"
        android:background="@drawable/btn_bg_shape_blue"/>

</LinearLayout>
