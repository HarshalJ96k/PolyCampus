<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:gravity="center">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:lottie_fileName="InternetConnection.json"
        app:lottie_speed="6"
        app:lottie_loop="true"
        app:lottie_autoPlay="true"
        android:layout_marginTop="8sp"
        android:id="@+id/registrationlottie"
        android:layout_centerHorizontal="true"
        android:visibility="visible">

    </com.airbnb.lottie.LottieAnimationView>

    <!--    <ImageView-->
<!--        android:layout_width="150dp"-->
<!--        android:layout_height="150dp"-->
<!--        android:src="@drawable/no_wifi"/>-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oops!"
        android:textColor="@color/black"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="@font/cambo"
        android:layout_marginTop="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NO INTERNET "
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/cambo"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You are not connected to the Internet"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="normal"
        android:fontFamily="@font/cambo"
        android:layout_marginTop="8dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLEASE TURN ON"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/cambo"
        android:layout_marginTop="12dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnCheckInternetConnection"
        android:text="Try Again"
        android:textColor="@color/skyblue"
        android:background="@drawable/btn_backgroundshape"
        android:layout_margin="24dp"
        android:fontFamily="@font/cambo"
        android:textStyle="bold"
        android:textSize="16dp"/>

</LinearLayout>
