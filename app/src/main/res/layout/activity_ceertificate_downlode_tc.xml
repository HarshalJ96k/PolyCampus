<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Certificate Container -->
        <FrameLayout
            android:id="@+id/certificateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/certificate_border"
            android:elevation="8dp"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Header Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOVERNMENT OF MAHARASHTRA"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="GOVERNMENT POLYTECHNIC, MURTIZAPUR"
                        android:textColor="@color/primary_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N.H.06, Murtizapur-Amravati Road, Hendaj, Murtizapur"
                        android:textColor="@color/gray_600"
                        android:textSize="10sp"
                        android:gravity="center" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/primary_blue" />

                <!-- Title Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="LEAVING CERTIFICATE"
                    android:textColor="@color/primary_blue"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/underline_blue_thin" />

                <!-- General Info -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SERIAL NO: 2671"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/tvTcDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE: 20/03/2026"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true" />

                </RelativeLayout>

                <!-- Certificate Fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/row_name"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_enrollment"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_course"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_dob"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_admission"
                        layout="@layout/layout_divider_small" />

                    <include
                        android:id="@+id/row_leaving"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_reason"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_conduct"
                        layout="@layout/item_certificate_row" />

                    <include
                        android:id="@+id/row_progress"
                        layout="@layout/item_certificate_row" />

                </LinearLayout>

                <!-- Closing Text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Certified that the above information is in accordance with the Institute Register."
                    android:textColor="@color/gray_800"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <!-- Signatures -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="60dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="100dp"
                            android:layout_height="1dp"
                            android:background="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clerk / Sign."
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="1dp"
                            android:background="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Principal"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Govt. Poly. Murtizapur"
                            android:textColor="@color/gray_600"
                            android:textSize="9sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Seal -->
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center|bottom"
                    android:layout_marginTop="-30dp"
                    android:gravity="center"
                    android:text="SEAL"
                    android:textColor="#20000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_dashed" />

            </LinearLayout>

        </FrameLayout>

        <!-- Download Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_download_pdf"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:padding="16dp"
            android:text="Download PDF Certificate"
            app:cornerRadius="12dp"
            app:icon="@drawable/icon_file" />

    </LinearLayout>
</ScrollView>
