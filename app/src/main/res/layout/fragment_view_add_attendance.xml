<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/light_green"
    tools:context=".HomeActivity"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="150dp"
            android:id="@+id/img_add_presenty_logo"
            android:src="@drawable/gpmzr_logo_img"
            android:layout_marginLeft="20dp"
            android:transitionName="splash_logo"
            />

        <TextView
            android:id="@+id/tv_add_current_presenty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:gravity="center"
            android:text="Add Current Presenty"
            android:textColor="@color/white"
            android:layout_below="@+id/img_add_presenty_logo"
            android:textSize="35dp"
            android:textStyle="bold"
            android:fontFamily="@font/bungee"/>

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/spinner_branch"
            android:entries="@array/branch"
            android:layout_below="@id/tv_add_current_presenty"/>
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/spinner_teacher_semester"
            android:entries="@array/semester"
            android:layout_below="@id/spinner_branch"
            />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/spinner_teacher_subject"
            android:entries="@array/select_your_subject"
            android:layout_below="@id/spinner_teacher_semester"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/til_add_presenty_date"
            android:layout_below="@id/spinner_teacher_subject"
            android:layout_margin="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <TextView
                android:id="@+id/tv_add_presenty_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/etbgshape"
                android:drawableLeft="@drawable/icon_date"
                android:drawablePadding="20dp"
                android:hint="Select Date"
                android:inputType="text"
                android:padding="20dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white" android:fontFamily="sans-serif-condensed-medium"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/til_add_presenty_time_from"
            android:layout_below="@id/til_add_presenty_date"
            android:layout_margin="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <TextView
                android:id="@+id/tv_add_presenty_time_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/etbgshape"
                android:drawableLeft="@drawable/icon_time_table"
                android:drawableTint="@color/white"
                android:drawablePadding="20dp"
                android:hint="Select Time From"
                android:inputType="text"
                android:padding="20dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:fontFamily="sans-serif-condensed-medium"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/til_add_presenty_time_to"
            android:layout_below="@id/til_add_presenty_time_from"
            android:layout_margin="4dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <TextView
                android:id="@+id/tv_add_presenty_time_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/etbgshape"
                android:drawableLeft="@drawable/icon_time_table"
                android:drawableTint="@color/white"
                android:drawablePadding="20dp"
                android:hint="Select Time To"
                android:inputType="text"
                android:padding="20dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:fontFamily="sans-serif-condensed-medium"/>

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_presenty_add_presenty"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/til_add_presenty_time_to"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/purple_700"
            android:text="Add Attendance"
            android:fontFamily="sans-serif-condensed-medium"
            android:textColor="@color/white"/>

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/add_presenty_cirle"
            android:src="@drawable/circle"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="-50dp"
            android:layout_marginBottom="-30dp"
            />

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/add_presenty_circle1"
            android:src="@drawable/circle_180"
            android:layout_alignParentRight="true"
            android:layout_marginRight="-50dp"
            android:layout_marginTop="-30dp"
            />

    </RelativeLayout>

</ScrollView>
