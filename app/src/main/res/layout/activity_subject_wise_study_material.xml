<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SubjectWiseStudyMaterialActivity"
    android:orientation="vertical">

    <androidx.appcompat.widget.SearchView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/svSubjectwiseStudyMaterial"
    app:queryHint="Search by Subject,Study Material "
    app:iconifiedByDefault="false"
    android:layout_margin="16sp"
    android:padding="8sp"
    android:background="@drawable/etbgshape"
    />
    <ListView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/lvSubjectwiseStudyMaterial"
        android:layout_margin="16sp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvSubjectwiseStudyMaterialNoMaterialAvailable"
        android:text="No Material Available"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="16dp"
        android:fontFamily="@font/cambo"
        android:visibility="gone"/>

</LinearLayout>
