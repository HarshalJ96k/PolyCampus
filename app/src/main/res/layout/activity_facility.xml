<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Campus Facilities"
            app:titleTextColor="@color/primary_blue"
            app:navigationIcon="@drawable/baseline_arrow_back_24"
            app:navigationIconTint="@color/primary_blue" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Girls Hostel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/gpmzrgirlshostel"
                        app:shapeAppearanceOverlay="@style/RoundedTopCorners" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_hotel_24"
                                app:tint="@color/primary_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-black"
                                android:text="Girls' Hostel"
                                android:textColor="@color/gray_800"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Smart Rooms with Modern Setup" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Capacity of 48 Students" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Separate Beds and Study Tables" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="24-Hour Electricity Backup" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Reliable and Clean Water Supply" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Boys Hostel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/gpmzrboyshostel"
                        app:shapeAppearanceOverlay="@style/RoundedTopCorners" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_hotel_24"
                                app:tint="@color/primary_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-black"
                                android:text="Boys' Hostel"
                                android:textColor="@color/gray_800"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Spacious and Ventilated Rooms" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="High Capacity (180+ Admissions)" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Individual Furniture Provided" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="24/7 Power and Security" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Library -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/library"
                        app:shapeAppearanceOverlay="@style/RoundedTopCorners" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_local_library_24"
                                app:tint="@color/primary_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-black"
                                android:text="Central Library"
                                android:textColor="@color/gray_800"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Vast Collection (10,000+ Books)" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Large and Airy Reading Room" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Comfortable Seating Arrangement" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Easy Registration for Students" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Workshop -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/workshop"
                        app:shapeAppearanceOverlay="@style/RoundedTopCorners" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/baseline_build_24"
                                app:tint="@color/primary_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-black"
                                android:text="Skill Workshop"
                                android:textColor="@color/gray_800"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Modern Woodworking Section" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Advanced Welding Facilities" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Latest Industrial Machinery" />

                        <TextView
                            style="@style/ProgramItem"
                            android:text="Practical Fitting &amp; Repair Unit" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
