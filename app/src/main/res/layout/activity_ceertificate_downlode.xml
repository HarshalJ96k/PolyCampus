<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Certificate Container -->
        <FrameLayout
            android:id="@+id/certificateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/certificate_border"
            android:elevation="8dp"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Header Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOVERNMENT OF MAHARASHTRA"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="GOVERNMENT POLYTECHNIC, MURTIZAPUR"
                        android:textColor="@color/primary_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="N.H.06, Murtizapur-Amravati Road, Hendaj, Murtizapur"
                        android:textColor="@color/gray_600"
                        android:textSize="10sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone: (07256) 243282  |  Email: gpmurtizapur@yahoo.com"
                        android:textColor="@color/gray_600"
                        android:textSize="9sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/primary_blue" />

                <!-- Date and Ref Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTWARD NO: GPMZR/SS/BONA/20"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/tvCertificateDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE: 20/03/2026"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true" />

                </RelativeLayout>

                <!-- Title Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="BONAFIDE CERTIFICATE"
                    android:textColor="@color/primary_blue"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/underline_blue_thin" />

                <!-- Certificate Body -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/studentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="8dp"
                        android:text="This is to certify that, Mr. / Miss [Student Name] is a bonafide student of GOVERNMENT POLYTECHNIC, MURTIZAPUR for the Academic Year 2023 - 2024."
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/studentDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="8dp"
                        android:text="He / She is currently studying in [Semester] Semester of Diploma in [Branch Name] (Polytechnic Course)."
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="8dp"
                        android:text="To the best of our knowledge, his / her conduct and character during the course period has been EXCELLENT."
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:gravity="start" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Purpose: Issued on student's request for verification purpose."
                        android:textColor="@color/gray_600"
                        android:textSize="11sp"
                        android:textStyle="italic" />

                </LinearLayout>

                <!-- Footer / SignaturesSection -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp">

                    <!-- Clerk Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="100dp"
                            android:layout_height="1dp"
                            android:background="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clerk / Sign."
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Principal Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="1dp"
                            android:background="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Principal"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Govt. Poly. Murtizapur"
                            android:textColor="@color/gray_600"
                            android:textSize="10sp" />

                    </LinearLayout>

                </RelativeLayout>

                <!-- Seal Placeholder -->
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center|bottom"
                    android:layout_marginTop="-40dp"
                    android:gravity="center"
                    android:text="OFFICIAL\nSEAL"
                    android:textColor="#20000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/circle_dashed" />

            </LinearLayout>

        </FrameLayout>

        <!-- Download Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:padding="16dp"
            android:text="Download PDF Certificate"
            app:cornerRadius="12dp"
            app:icon="@drawable/icon_file" />

    </LinearLayout>
</ScrollView>
