<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyProfile.UpdateProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="25dp">

        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:fontFamily="@font/cambo"
            android:gravity="center"
            android:text="Update Profile"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:textStyle="bold" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:passwordToggleDrawable="@drawable/password_toggle"
            app:boxStrokeWidth="2sp" >



            <EditText
                android:id="@+id/etUpdateName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="10sp"
                android:layout_margin="8sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/icon_person"
                android:drawablePadding="8sp"
                android:layout_marginTop="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Name"
                android:inputType="textPersonName"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:passwordToggleDrawable="@drawable/password_toggle"
            app:boxStrokeWidth="2sp" >

            <EditText
                android:id="@+id/etUpdateMobileno"
                android:enabled="false"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:drawableLeft="@drawable/icon_branch"
                android:drawableTint="@color/black"
                android:drawablePadding="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Mobile No"
                android:inputType="number"
                android:padding="8sp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:editable="false"
                android:longClickable="false"
                />

        </com.google.android.material.textfield.TextInputLayout>




        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:boxStrokeWidth="2sp" >



            <EditText
                android:id="@+id/etUpdateParentno"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginLeft="10sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/icon_parentno"
                android:drawablePadding="8sp"

                android:fontFamily="@font/cambo"
                android:hint="Parent No"
                android:inputType="number"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            android:layout_marginTop="8dp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:boxStrokeWidth="2sp" >


            <EditText
                android:id="@+id/etUpdateEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginLeft="10sp"
                android:drawableLeft="@drawable/icon_email"
                android:drawablePadding="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Email"
                android:inputType="textPersonName"
                android:padding="8sp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            android:layout_marginTop="8dp"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"

            app:boxStrokeWidth="2sp" >


            <EditText
                android:id="@+id/etUpdateGender"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginLeft="10sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/icon_gender"
                android:drawablePadding="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Gender"
                android:inputType="textPersonName"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            android:layout_marginTop="8dp"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:passwordToggleDrawable="@drawable/password_toggle"
            app:boxStrokeWidth="2sp" >

            <EditText
                android:id="@+id/etUpdateAddress"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginLeft="10sp"
                android:textColor="@color/black"
                android:drawableLeft="@drawable/icon_address"
                android:drawablePadding="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Address"
                android:inputType="textPersonName"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            android:layout_marginTop="8dp"
            app:boxStrokeWidth="2sp" >


            <EditText
                android:id="@+id/etUpdateBranch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginTop="8sp"
                android:drawableLeft="@drawable/icon_branch"
                android:drawableTint="@color/black"
                android:drawablePadding="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Branch"
                android:inputType="text"
                android:padding="8sp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:editable="false"
                android:longClickable="false"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:passwordToggleDrawable="@drawable/password_toggle"
            app:boxStrokeWidth="2sp" >

            <EditText
                android:id="@+id/etUpdateSem"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginTop="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Sem "
                android:drawableLeft="@drawable/icon_sem"
                android:drawableTint="@color/black"
                android:drawablePadding="8sp"
                android:textColor="@color/black"
                android:inputType="numberDecimal"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:editable="false"
                android:longClickable="false"
                />
        </com.google.android.material.textfield.TextInputLayout>

   <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8sp"
            android:layout_marginRight="8sp"
            app:boxStrokeColor="@color/skyblue"
            app:hintTextColor="@color/black"
            app:passwordToggleEnabled="false"
            app:passwordToggleTint="#80000000"
            app:passwordToggleDrawable="@drawable/password_toggle"
            app:boxStrokeWidth="2sp" >

            <EditText
                android:id="@+id/etUpdateSubject"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8sp"
                android:layout_marginTop="8sp"
                android:fontFamily="@font/cambo"
                android:hint="Year"
                android:drawableLeft="@drawable/icon_subject1"
                android:drawableTint="@color/black"
                android:drawablePadding="8sp"
                android:textColor="@color/black"
                android:inputType="numberDecimal"
                android:padding="8sp"
                android:textColorHint="@color/black"
                android:textSize="20dp"
                android:textStyle="bold"
                android:focusable="false"
                android:clickable="false"
                android:editable="false"
                android:longClickable="false"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnUpdateprofileSaveChanges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/skyblue"
            android:text="Save Changes "
            android:textColor="#F44336"
            android:textSize="20dp"
            android:fontFamily="@font/cambo"
            android:textStyle="bold"
            android:layout_marginBottom="50dp"/>

    </LinearLayout>


</ScrollView>






